# Enable Places API (New); Geocoding API is optional for the address label.
GOOGLE_MAPS_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DATABASE_URI=sqlite:///pratiko.db
# Generate a private random value of at least 32 characters to enable accounts.
PRATIKO_SESSION_SECRET=
# Set to 1 when serving the app over HTTPS.
PRATIKO_SESSION_SECURE=0
